const content = localesContent[currentLocale as keyof typeof localesContent] ?? localesContent.en
---

<section class="container mx-auto px-4 py-16 max-w-[600px]">
	<div id="success-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
		<div class="absolute inset-0 bg-foreground/80 backdrop-blur-sm" id="modal-backdrop"></div>
		<div class="relative bg-background rounded-lg border border-foreground/10 shadow-2xl max-w-md w-full p-8 z-10">
			<button
				id="modal-close"
				class="absolute top-4 right-4 text-foreground hover:text-foreground/70 transition-colors"
				aria-label={content.modalCloseButton}
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<div class="text-center space-y-4">
				<div class="mx-auto w-16 h-16 bg-none border-2 border-primary rounded-full flex items-center justify-center mb-4">
					<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
				</div>
				<h2 class="text-4xl font-bold text-primary">
					<span id="modal-message-1">{content.thanksMessage}</span><span id="modal-user-name"></span>!
				</h2>
				<p class="text-foreground text-2xl" id="modal-message-2">{content.thanksMessage2}</p>
				<p class="text-primary text-2xl font-medium" id="modal-user-email"></p>
				<img src={SixthSenseLogo.src} alt="Sixth Sense Pay" class="w-1/2 mx-auto" />
			</div>
		</div>
	</div>

	<form
		id="account-deletion-form"
		class="flex flex-col gap-4"
		enctype="multipart/form-data"
		data-error-generic={content.formErrorMessage}
		data-error-required={content.errors.required}
		data-error-too-large={content.errors.tooLarge}
		data-error-invalid-file={content.errors.invalidFile}
		data-sending-text={content.sendingButtonText}
		data-submit-text={content.formButtonText}
		data-no-file={content.idDocument.noFile}
	>
		<div class="flex flex-col gap-2 w-full max-w-[600px] mx-auto">
			<label for="name" class="text-sm font-medium text-foreground">{content.name.label}*</label>
			<input
				id="name"
				type="text"
				name="name"
				placeholder={content.name.placeholder}
				required
				autocomplete="name"
				class="account-deletion-input w-full p-2 border-none bg-background placeholder:text-foreground/50"
			/>
			<div class="h-px w-full bg-foreground/30"></div>
		</div>
		<div class="flex flex-col gap-2 w-full max-w-[600px] mx-auto">
			<label for="email" class="text-sm font-medium text-foreground">{content.email.label}*</label>
			<input
				id="email"
				type="email"
				name="email"
				placeholder={content.email.placeholder}
				required
				autocomplete="email"
				class="account-deletion-input w-full p-2 border-none bg-background placeholder:text-foreground/50"
			/>
			<div class="h-px w-full bg-foreground/30"></div>
		</div>
		<div class="flex flex-col gap-2 w-full max-w-[600px] mx-auto">
			<label for="idDocument" class="text-sm font-medium text-foreground">{content.idDocument.label}*</label>
			<input
				id="idDocument"
				type="file"
				name="idDocument"
				required
				accept="image/jpeg,image/png,image/webp,application/pdf,.jpg,.jpeg,.png,.webp,.pdf"
				class="account-deletion-input w-full p-2 border-none bg-background text-foreground file:mr-4 file:rounded-md file:border-0 file:bg-foreground file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-background"
			/>
			<p id="selected-file" class="text-sm text-foreground/70">{content.idDocument.noFile}</p>
			<p class="text-sm text-foreground/70">{content.idDocument.hint}</p>
			<div class="h-px w-full bg-foreground/30"></div>
		</div>
		<input type="hidden" name="locale" value={currentLocale} />
		<p id="form-error" class="hidden text-sm text-primary" role="alert"></p>
		<div class="relative self-end max-w-[220px] w-full" id="button-wrapper">
			<Button
				type="submit"
				id="submit-button"
				disabled
				data-tooltip={content.tooltipText}
				class="w-full bg-neutral-950 text-neutral-50 hover:bg-neutral-800 active:bg-neutral-700 disabled:opacity-65 disabled:cursor-not-allowed"
			>
				{content.formButtonText}
			</Button>
			<div
				id="tooltip"
				class="hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 text-sm text-white bg-neutral-800 rounded-md whitespace-nowrap z-50"
			>
				{content.tooltipText}
				<div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-neutral-800"></div>
			</div>
		</div>
	</form>
</section>

<style>
	#account-deletion-form :is(input[type="text"], input[type="email"], input[type="file"]) {
		background-color: #fff;
		background-image: none;
		box-shadow: none;
		accent-color: var(--foreground);
	}

	#account-deletion-form input:-webkit-autofill,
	#account-deletion-form input:-webkit-autofill:hover,
	#account-deletion-form input:-webkit-autofill:focus {
		box-shadow: 0 0 0 1000px #fff inset;
		-webkit-text-fill-color: var(--foreground);
	}
</style>

<script>
	import { actions, isInputError } from "astro:actions"

	const MAX_FILE_BYTES = 4 * 1024 * 1024
	const ALLOWED_TYPES = ["image/jpeg", "image/jpg", "image/png", "image/webp", "application/pdf"]
	const ALLOWED_EXTENSIONS = [".jpg", ".jpeg", ".png", ".webp", ".pdf"]

	function isAllowedFile(file: File) {
		if (ALLOWED_TYPES.includes(file.type)) return true
		const name = file.name.toLowerCase()
		return ALLOWED_EXTENSIONS.some((ext) => name.endsWith(ext))
	}

	document.addEventListener("DOMContentLoaded", () => {
		const form = document.getElementById("account-deletion-form") as HTMLFormElement | null
		const buttonWrapper = document.getElementById("button-wrapper")
		const submitButton = document.getElementById("submit-button") as HTMLButtonElement | null
		const tooltip = document.getElementById("tooltip") as HTMLDivElement | null
		const nameInput = form?.querySelector('input[name="name"]') as HTMLInputElement | null
		const emailInput = form?.querySelector('input[name="email"]') as HTMLInputElement | null
		const fileInput = form?.querySelector('input[name="idDocument"]') as HTMLInputElement | null
		const selectedFile = document.getElementById("selected-file")
		const formError = document.getElementById("form-error")
		const modal = document.getElementById("success-modal")
		const modalClose = document.getElementById("modal-close")
		const modalBackdrop = document.getElementById("modal-backdrop")
		const modalUserName = document.getElementById("modal-user-name")
		const modalUserEmail = document.getElementById("modal-user-email")

		if (!form || !submitButton || !nameInput || !emailInput || !fileInput) return

		const messages = {
			generic: form.dataset.errorGeneric || "",
			required: form.dataset.errorRequired || "",
			tooLarge: form.dataset.errorTooLarge || "",
			invalidFile: form.dataset.errorInvalidFile || "",
			sending: form.dataset.sendingText || "",
			submit: form.dataset.submitText || "",
			noFile: form.dataset.noFile || "",
		}

		function hasValidFile() {
			const file = fileInput?.files?.[0]
			return Boolean(file && file.size > 0)
		}

		function updateButtonState() {
			const isValid = nameInput.value.trim() !== "" && emailInput.value.trim() !== "" && hasValidFile()
			submitButton.disabled = !isValid
		}

		function showError(message: string) {
			if (!formError) return
			formError.textContent = message
			formError.classList.remove("hidden")
		}

		function clearError() {
			if (!formError) return
			formError.textContent = ""
			formError.classList.add("hidden")
		}

		function showModal(name: string, email: string) {
			if (modal && modalUserName && modalUserEmail) {
				modalUserName.textContent = name
				modalUserEmail.textContent = email
				modal.classList.remove("hidden")
				modal.classList.add("flex")
			}
		}

		function closeModal() {
			if (modal) {
				modal.classList.add("hidden")
				modal.classList.remove("flex")
			}
		}

		function clearForm() {
			form.reset()
			if (selectedFile) selectedFile.textContent = messages.noFile
			updateButtonState()
		}

		function errorFromFields(fields: Record<string, string[] | undefined>) {
			const documentErrors = fields.idDocument ?? []
			if (documentErrors.includes("too_large")) return messages.tooLarge
			if (documentErrors.includes("invalid_type")) return messages.invalidFile
			if (documentErrors.includes("required")) return messages.required
			return messages.generic
		}

		fileInput.addEventListener("change", () => {
			const file = fileInput.files?.[0]
			if (selectedFile) {
				selectedFile.textContent = file?.name || messages.noFile
			}
			clearError()
			if (file && file.size > MAX_FILE_BYTES) {
				showError(messages.tooLarge)
			} else if (file && file.size > 0 && !isAllowedFile(file)) {
				showError(messages.invalidFile)
			}
			updateButtonState()
		})

		form.addEventListener("submit", async (event) => {
			event.preventDefault()
			clearError()

			const file = fileInput.files?.[0]
			if (!file || file.size === 0) {
				showError(messages.required)
				return
			}
			if (file.size > MAX_FILE_BYTES) {
				showError(messages.tooLarge)
				return
			}
			if (!isAllowedFile(file)) {
				showError(messages.invalidFile)
				return
			}

			const formData = new FormData(form)
			const name = String(formData.get("name") || "")
			const email = String(formData.get("email") || "")

			try {
				submitButton.disabled = true
				submitButton.textContent = messages.sending

				const { data, error } = await actions.sendAccountDeletionRequest(formData)

				if (error) {
					showError(isInputError(error) ? errorFromFields(error.fields) : messages.generic)
					return
				}

				if (!data?.success) {
					const code = data?.error
					if (code === "too_large") showError(messages.tooLarge)
					else if (code === "invalid_type" || code === "required") showError(code === "required" ? messages.required : messages.invalidFile)
					else showError(messages.generic)
					return
				}

				showModal(name, email)
				clearForm()
			} catch (err) {
				console.error("Error submitting account deletion request:", err)
				showError(messages.generic)
			} finally {
				submitButton.textContent = messages.submit
				updateButtonState()
			}
		})

		modalClose?.addEventListener("click", closeModal)
		modalBackdrop?.addEventListener("click", closeModal)

		buttonWrapper?.addEventListener("mouseenter", () => {
			if (submitButton.disabled && tooltip) tooltip.classList.remove("hidden")
		})
		buttonWrapper?.addEventListener("mouseleave", () => {
			tooltip?.classList.add("hidden")
		})

		nameInput.addEventListener("input", () => {
			clearError()
			updateButtonState()
		})
		emailInput.addEventListener("input", () => {
			clearError()
			updateButtonState()
		})

		updateButtonState()
	})
</script>
