---
const { currentLocale } = Astro.props
import { Button } from "@/components/starwind/button"
import SixthSenseLogo from "@/assets/logo-main-1color-fondo-claro@2x.png"

const localesContent = {
	en: {
		thanksMessage: "We received your request, ",
		thanksMessage2: "Our team will review it and contact you at:",
		modalCloseButton: "Close",
		name: {
			label: "Full name",
			placeholder: "First and last name",
		},
		email: {
			label: "Email registered on the account",
			placeholder: "Enter the email on your account",
		},
		idDocument: {
			label: "Photo of your ID document",
			hint: "JPG, PNG, WEBP or PDF. Maximum 4 MB.",
			noFile: "No file selected",
		},
		formButtonText: "Send request",
		sendingButtonText: "Sending…",
