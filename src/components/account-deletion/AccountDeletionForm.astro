			noFile: "Ningún archivo seleccionado",
		},
		formButtonText: "Enviar solicitud",
		sendingButtonText: "Enviando…",
		formErrorMessage: "No se pudo enviar la solicitud. Intentá de nuevo.",
		tooltipText: "Completá nombre, email y el documento de identidad",
		errors: {
			required: "Adjuntá una foto de tu documento de identidad.",
			tooLarge: "El archivo es demasiado grande. El máximo es 4 MB.",
			invalidFile: "Usá un archivo JPG, PNG, WEBP o PDF.",
		},
	},
	hr: {
		thanksMessage: "Zaprimili smo vaš zahtjev, ",
		thanksMessage2: "Naš tim će ga pregledati i javiti vam na:",
		modalCloseButton: "Zatvori",
		name: {
			label: "Ime i prezime",
			placeholder: "Unesite ime i prezime",
		},
		email: {
			label: "E-mail registriran na računu",
			placeholder: "Unesite e-mail s vašeg računa",
		},
		idDocument: {
			label: "Fotografija osobne iskaznice",
			hint: "JPG, PNG, WEBP ili PDF. Najviše 4 MB.",
			noFile: "Nije odabrana datoteka",
		},
		formButtonText: "Pošalji zahtjev",
		sendingButtonText: "Slanje…",
		formErrorMessage: "Zahtjev nije poslan. Pokušajte ponovo.",
		tooltipText: "Ispunite ime, e-mail i dokument identiteta",
		errors: {
			required: "Priložite fotografiju dokumenta identiteta.",
			tooLarge: "Datoteka je prevelika. Najveća veličina je 4 MB.",
			invalidFile: "Koristite JPG, PNG, WEBP ili PDF datoteku.",
		},
	},
	bs: {
		thanksMessage: "Primili smo vaš zahtjev, ",
		thanksMessage2: "Naš tim će ga pregledati i javiti vam na:",
		modalCloseButton: "Zatvori",
		name: {
			label: "Ime i prezime",
			placeholder: "Unesite ime i prezime",
		},
		email: {
			label: "E-mail registrovan na računu",
			placeholder: "Unesite e-mail s vašeg računa",
		},
		idDocument: {
			label: "Fotografija dokumenta identiteta",
			hint: "JPG, PNG, WEBP ili PDF. Najviše 4 MB.",
			noFile: "Nije odabrana datoteka",
		},
		formButtonText: "Pošalji zahtjev",
		sendingButtonText: "Slanje…",
		formErrorMessage: "Zahtjev nije poslan. Pokušajte ponovo.",
		tooltipText: "Ispunite ime, e-mail i dokument identiteta",
		errors: {
			required: "Priložite fotografiju dokumenta identiteta.",
			tooLarge: "Datoteka je prevelika. Najveća veličina je 4 MB.",
			invalidFile: "Koristite JPG, PNG, WEBP ili PDF datoteku.",
		},
	},
	sr: {
		thanksMessage: "Primili smo vaš zahtev, ",
		thanksMessage2: "Naš tim će ga pregledati i javiti vam na:",
		modalCloseButton: "Zatvori",
		name: {
			label: "Ime i prezime",
			placeholder: "Unesite ime i prezime",
		},
		email: {
			label: "E-mail registrovan na nalogu",
			placeholder: "Unesite e-mail sa vašeg naloga",
		},
		idDocument: {
			label: "Fotografija dokumenta identiteta",
			hint: "JPG, PNG, WEBP ili PDF. Najviše 4 MB.",
			noFile: "Nije odabrana datoteka",
		},
